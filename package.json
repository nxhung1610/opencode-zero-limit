{
  "name": "relaydock",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "author": "nxhung1610",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nxhung1610/relaydock.git"
  },
  "type": "module",
  "bin": {
    "relaydock": "./bin/relaydock.cjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:server && tsc && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "test": "npm run test:server",
    "test:server": "npm run build:server && node --test dist-server/tests.test.js",
    "serve": "node ./bin/relaydock.cjs serve",
    "web": "npm run build && node ./bin/relaydock.cjs serve",
    "ui:smoke": "node scripts/ui-smoke.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "^1.54.0",
    "radix-ui": "^1.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socks-proxy-agent": "^10.1.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
